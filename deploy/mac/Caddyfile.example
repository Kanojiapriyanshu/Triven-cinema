# Replace cinema.example.com with your real domain.
# DNS must point to this Mac, or put Cloudflare Tunnel in front instead.
cinema.example.com {
    encode zstd gzip

    # Optional but strongly recommended for a private/internal GPU-costly app:
    # basic_auth {
    #     admin <PASTE_A_CADDY_HASHED_PASSWORD_HERE>
    # }

    # Send API/media directly to FastAPI so large MP4 delivery does not take an
    # unnecessary hop through the Next.js process. Both services stay loopback-only.
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /media/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        reverse_proxy 127.0.0.1:3000
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
}
