# Alternative to host Nginx: run Caddy on the VPS host for automatic HTTPS.
# Docker publishes both upstreams on loopback only.
cinema.devansh.info {
    encode zstd gzip

    request_body {
        max_size 500MB
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:3337
    }

    handle /media/* {
        reverse_proxy 127.0.0.1:3337
    }

    handle {
        reverse_proxy 127.0.0.1:3336
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    log {
        output stdout
        format console
    }
}
