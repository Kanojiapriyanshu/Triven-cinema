# Triven Cinema API
APP_NAME="Triven Cinema API"
APP_ENV="development"
DEBUG=true
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Gemini scene planner
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_SECONDS=12
GEMINI_THINKING_LEVEL="low"

# Default inference provider: huggingface or modal
VIDEO_PROVIDER="huggingface"

# Hugging Face development provider
HF_TOKEN=""
HF_LTX_SPACE="ChopperBlu/ltx-2-5-demo"

# Modal production provider
MODAL_APP_NAME="triven-cinema-ltx"
MODAL_FUNCTION_NAME="generate_video"
# Used at Modal deployment time. B200 is the requested benchmark target.
TRIVEN_MODAL_GPU="B200"
TRIVEN_MODAL_SCALEDOWN_WINDOW=15
# Pin this to the validated LTX-2 commit/tag before a long-lived production deployment.
TRIVEN_LTX_REPO_REF="main"

# Optional cost estimates. Copy CURRENT hourly prices from your Modal dashboard.
# Keep 0 until verified. These are estimates, not billed-cost statements.
MODAL_GPU_HOURLY_USD_B200=0
MODAL_GPU_HOURLY_USD_H200=0
MODAL_GPU_HOURLY_USD_H100=0

# Render defaults
DEFAULT_RENDER_QUALITY="preview"
DEFAULT_DECODER="conv"
DEFAULT_SCENE_DURATION_SECONDS=1

# Single-Mac job/cost safety
JOB_WORKERS=1
JOB_MAX_PENDING=3
JOB_RETENTION_DAYS=14
ENABLE_SYNC_RENDER_ENDPOINTS=true
ENABLE_METRICS_ENDPOINT=true

# Local disk retention
PREVIEW_RETENTION_DAYS=3
FINAL_RETENTION_DAYS=30
MINIMUM_FREE_DISK_GB=10
METRICS_MAX_BYTES=10485760

# Local FFmpeg/ffprobe safety timeouts
FFMPEG_TIMEOUT_SECONDS=900
FFPROBE_TIMEOUT_SECONDS=30
LOG_MAX_BYTES=20971520
