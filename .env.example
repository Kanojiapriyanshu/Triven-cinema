# Triven Cinema API
APP_NAME="Triven Cinema API"
APP_ENV="development"
DEBUG=true
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Production only: public hostname used by host Nginx on the Hostinger VPS.
TRIVEN_DOMAIN=""

# Gemini scene planner
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_SECONDS=12
GEMINI_THINKING_LEVEL="low"

# Default inference provider: huggingface or modal
VIDEO_PROVIDER="huggingface"

# Hugging Face development provider
HF_TOKEN=""
HF_LTX_SPACE="ChopperBlu/ltx-2-5-demo"

# Modal production provider
# On a VPS/container, authenticate the Modal client with a dedicated API token.
MODAL_TOKEN_ID=""
MODAL_TOKEN_SECRET=""
MODAL_APP_NAME="triven-cinema-ltx"
MODAL_FUNCTION_NAME="generate_video"
# Used at Modal deployment time. B200 is the requested benchmark target.
TRIVEN_MODAL_GPU="B200"
TRIVEN_MODAL_SCALEDOWN_WINDOW=15
# Pin this to the validated LTX-2 commit/tag before a long-lived production deployment.
TRIVEN_LTX_REPO_REF="main"

# Optional cost estimates. Copy CURRENT hourly prices from your Modal dashboard.
# Keep 0 until verified. These are estimates, not billed-cost statements.
MODAL_GPU_HOURLY_USD_B200=0
MODAL_GPU_HOURLY_USD_H200=0
MODAL_GPU_HOURLY_USD_H100=0

# Render defaults
DEFAULT_RENDER_QUALITY="preview"
DEFAULT_DECODER="conv"
DEFAULT_SCENE_DURATION_SECONDS=5
# Long-form customer profiles. Modal uses upstream LTX-2.5 temporal windowing
# with carry/blend overlap for 15s/30s scenes; scene-to-scene continuity still uses first-frame conditioning.
LTX_NATIVE_CHUNK_SECONDS=10
MAX_PREVIEW_SCENE_SECONDS=10
MAX_1080P_SCENE_SECONDS=30
MAX_4K_SCENE_SECONDS=15
MAX_FACTORY_DURATION_SECONDS=300

# Character cardinality / duplicate-subject guard.
CONTINUITY_VISION_QC_ENABLED=true
CONTINUITY_QC_TIMEOUT_SECONDS=12
CONTINUITY_QC_MAX_FRAMES=3

# Signed browser workspace identity. Required in production when Billing or YouTube is enabled.
TRIVEN_SECRET_KEY=""

# Stripe Checkout credit packs. Keep enforcement off until live webhook verification is complete.
BILLING_ENABLED=false
BILLING_ENFORCE_CREDITS=false
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_STUDIO=""
STRIPE_STARTER_SECONDS=300
STRIPE_PRO_SECONDS=1800
STRIPE_STUDIO_SECONDS=7200

# Connected YouTube channel. OAuth callback must be registered in Google Cloud.
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI=""
# Keep false until the Google API project/channel flow is ready for non-private publishing.
YOUTUBE_ALLOW_PUBLIC=false

# Single-VPS job/cost safety
JOB_WORKERS=1
JOB_MAX_PENDING=3
JOB_RETENTION_DAYS=14
ENABLE_SYNC_RENDER_ENDPOINTS=true
ENABLE_METRICS_ENDPOINT=true

# VPS disk retention
PREVIEW_RETENTION_DAYS=3
FINAL_RETENTION_DAYS=30
MINIMUM_FREE_DISK_GB=10
METRICS_MAX_BYTES=10485760

# Local FFmpeg/ffprobe safety timeouts
FFMPEG_TIMEOUT_SECONDS=900
FFPROBE_TIMEOUT_SECONDS=30
LOG_MAX_BYTES=20971520
