# Triven Cinema - Hostinger VPS production profile
# Hostname only; do not include https://
TRIVEN_DOMAIN="devansh.info"

APP_NAME="Triven Cinema API"
APP_ENV="production"
DEBUG=false
FRONTEND_URL="https://devansh.info"
# Browser requests remain same-origin through Caddy, so CORS can stay empty.
CORS_ORIGINS=""

# Gemini storyboard planner. If unavailable, Triven falls back to a local storyboard.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_SECONDS=12
GEMINI_THINKING_LEVEL="low"

# Production inference provider
VIDEO_PROVIDER="modal"
HF_TOKEN=""
HF_LTX_SPACE="ChopperBlu/ltx-2-5-demo"

# Modal client authentication for the VPS containers.
# Create a dedicated production API token; do not copy a personal ~/.modal.toml to the server.
MODAL_TOKEN_ID=""
MODAL_TOKEN_SECRET=""
MODAL_APP_NAME="triven-cinema-ltx"
MODAL_FUNCTION_NAME="generate_video"
TRIVEN_MODAL_GPU="B200"
TRIVEN_MODAL_SCALEDOWN_WINDOW=15
# Pin this to the exact LTX commit/tag you validated before long-lived production use.
TRIVEN_LTX_REPO_REF="main"

# Optional cost estimates. Keep 0 until copied from the current Modal dashboard.
MODAL_GPU_HOURLY_USD_B200=0
MODAL_GPU_HOURLY_USD_H200=0
MODAL_GPU_HOURLY_USD_H100=0

DEFAULT_RENDER_QUALITY="preview"
DEFAULT_DECODER="conv"
DEFAULT_SCENE_DURATION_SECONDS=1

# One paid render worker is the safest default for the current single-VPS architecture.
JOB_WORKERS=1
JOB_MAX_PENDING=3
JOB_RETENTION_DAYS=14
ENABLE_SYNC_RENDER_ENDPOINTS=false
ENABLE_METRICS_ENDPOINT=false

# VPS-local storage retention/safety.
PREVIEW_RETENTION_DAYS=3
FINAL_RETENTION_DAYS=30
MINIMUM_FREE_DISK_GB=10
METRICS_MAX_BYTES=10485760
BACKUP_RETENTION_DAYS=7

FFMPEG_TIMEOUT_SECONDS=900
FFPROBE_TIMEOUT_SECONDS=30
LOG_MAX_BYTES=20971520
