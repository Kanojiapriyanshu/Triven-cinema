# Triven Cinema - Hostinger VPS production profile
# Hostname only; do not include https://
TRIVEN_DOMAIN="devansh.info"

APP_NAME="Triven Cinema API"
APP_ENV="production"
DEBUG=false
FRONTEND_URL="https://devansh.info"
# Browser requests remain same-origin through host Nginx, so CORS can stay empty.
CORS_ORIGINS=""

# Gemini storyboard planner. If unavailable, Triven falls back to a local storyboard.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_SECONDS=20
GEMINI_THINKING_LEVEL="low"
GEMINI_FALLBACK_MODELS="gemini-3.7-flash,gemini-3.6-flash"
GEMINI_MAX_ATTEMPTS_PER_MODEL=3
GEMINI_RETRY_BACKOFF_SECONDS=0.8

# Production inference provider
VIDEO_PROVIDER="modal"
HF_TOKEN=""
HF_LTX_SPACE="ChopperBlu/ltx-2-5-demo"

# Modal client authentication for the VPS containers.
# Create a dedicated production API token; do not copy a personal ~/.modal.toml to the server.
MODAL_TOKEN_ID=""
MODAL_TOKEN_SECRET=""
MODAL_APP_NAME="triven-cinema-ltx"
MODAL_FUNCTION_NAME="generate_video"
MODAL_AUDIO_RETAKE_FUNCTION_NAME="retake_audio"
TRIVEN_MODAL_GPU="B200"
TRIVEN_MODAL_SCALEDOWN_WINDOW=15
# Pin this to the exact LTX commit/tag you validated before long-lived production use.
TRIVEN_LTX_REPO_REF="v1.3.0"

# Optional cost estimates. Keep 0 until copied from the current Modal dashboard.
MODAL_GPU_HOURLY_USD_B200=0
MODAL_GPU_HOURLY_USD_H200=0
MODAL_GPU_HOURLY_USD_H100=0

DEFAULT_RENDER_QUALITY="preview"
DEFAULT_DECODER="conv"
DEFAULT_SCENE_DURATION_SECONDS=5
# Long-form customer profiles. Modal uses upstream LTX-2.5 temporal windowing
# with carry/blend overlap for 15s/30s scenes; scene-to-scene continuity still uses first-frame conditioning.
LTX_NATIVE_CHUNK_SECONDS=10
MAX_PREVIEW_SCENE_SECONDS=10
MAX_1080P_SCENE_SECONDS=30
MAX_4K_SCENE_SECONDS=15
MAX_FACTORY_DURATION_SECONDS=300
CINEMA_MAX_SCENE_SECONDS=10
# Final 1080p/4K jobs stop before paid GPU rendering if Gemini planning is unavailable.
FACTORY_ALLOW_FALLBACK_FINAL=false
FACTORY_AUDIO_QC_ENABLED=true
FACTORY_AUDIO_RETAKE_ENABLED=true
FACTORY_AUDIO_QC_STRICT_FINAL=true

# Character cardinality / duplicate-subject guard.
CONTINUITY_VISION_QC_ENABLED=true
CONTINUITY_QC_TIMEOUT_SECONDS=12
CONTINUITY_QC_MAX_FRAMES=3

# Signed browser workspace identity. Required in production when Billing or YouTube is enabled.
TRIVEN_SECRET_KEY=""

# Stripe Checkout credit packs. Keep enforcement off until live webhook verification is complete.
BILLING_ENABLED=false
BILLING_ENFORCE_CREDITS=false
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_STUDIO=""
STRIPE_STARTER_SECONDS=300
STRIPE_PRO_SECONDS=1800
STRIPE_STUDIO_SECONDS=7200

# Connected YouTube channel. OAuth callback must be registered in Google Cloud.
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI=""
# Keep false until the Google API project/channel flow is ready for non-private publishing.
YOUTUBE_ALLOW_PUBLIC=false

# One paid render worker is the safest default for the current single-VPS architecture.
JOB_WORKERS=1
JOB_MAX_PENDING=3
JOB_RETENTION_DAYS=14
ENABLE_SYNC_RENDER_ENDPOINTS=false
ENABLE_METRICS_ENDPOINT=false

# VPS-local storage retention/safety.
PREVIEW_RETENTION_DAYS=3
FINAL_RETENTION_DAYS=30
MINIMUM_FREE_DISK_GB=10
METRICS_MAX_BYTES=10485760
BACKUP_RETENTION_DAYS=7

FFMPEG_TIMEOUT_SECONDS=900
FFPROBE_TIMEOUT_SECONDS=30
LOG_MAX_BYTES=20971520
